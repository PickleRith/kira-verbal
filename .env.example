# Copy to .env and fill in locally. Never commit .env.
# Fake mode (the default) needs no credentials at all.
APP_ENV=development
DEMO_MODE=true
EVALUATOR_PROVIDER=fake
# Use 127.0.0.1, not localhost (Windows tries IPv6 ::1 first and stalls).
DATABASE_URL=postgresql+psycopg://kira:kira@127.0.0.1:5432/kira
REDIS_URL=redis://127.0.0.1:6379/0
FRONTEND_ORIGIN=http://localhost:3000
# EVALUATOR_PROVIDER=llm uses Claude. Credentials: LLM_API_KEY, or leave it empty and the
# Anthropic SDK reads ANTHROPIC_API_KEY / an `ant auth login` profile. Costs money per turn.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
# Must be >= LLM_TIMEOUT_SECONDS * (LLM_MAX_RETRIES + 1); lease must exceed it.
EVALUATOR_TIMEOUT_SECONDS=45
# Conversation layer: fake = fixed template lines; llm = Claude writes the line said before
# each question, checked by guardrails (template on any problem). One more call per turn.
RESPONDER_PROVIDER=fake
RESPONDER_MODEL=claude-haiku-5-5
RESPONDER_EFFORT=low
RESPONDER_TIMEOUT_SECONDS=5
# Side turns (questions about the topic, "say that again") that use no answer budget.
MAX_SIDE_TURNS=4
# Must exceed EVALUATOR_TIMEOUT_SECONDS + RESPONDER_TIMEOUT_SECONDS.
PROCESSING_LEASE_SECONDS=60
# Voice (optional). LiveKit Cloud project credentials (`lk cloud auth` or the Cloud dashboard).
# STT and TTS run through LiveKit Inference on these same credentials: no Deepgram or
# ElevenLabs keys are needed. Without these, the app works in text mode only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Any random string of 32+ characters, e.g. python -c "import secrets; print(secrets.token_hex(32))"
VOICE_WORKER_SECRET=
VOICE_AGENT_NAME=kira-verbal-voice
# Where the voice worker reaches this API
KIRA_API_URL=http://127.0.0.1:8000
VOICE_STT_MODEL=assemblyai/assemblyai-stt-3-7-realtime-agent
VOICE_TTS_MODEL=fishaudio/s2.1-pro
VOICE_TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a
SESSION_MAX_SECONDS=300
TRANSCRIPT_RETENTION_DAYS=7
